#!/usr/bin/env bash
# Deploy the website content to a remote host.
#
# usage: website-deploy <user>@<host> <root directory> <service>
#
# <service> is the systemd unit (e.g. website or website-draft) that serves
# <root directory>. It must exist on the remote host, and is reloaded (SIGHUP)
# after syncing with $WEBSITE_SYSTEMCTL, which defaults to "sudo systemctl".
set -euo pipefail

if [ "$#" -ne 3 ]; then
  echo "usage: website-deploy <user>@<host> <root directory> <service>" >&2
  exit 1
fi

target="$1"
root="${2%/}"
service="$3"

cd "$(git rev-parse --show-toplevel)"

# fail before syncing anything if there is nothing to reload afterwards
if ! ssh "$target" "systemctl cat '$service' >/dev/null 2>&1"; then
  echo "error: service '$service' does not exist on $target" >&2
  exit 1
fi

# talks is a submodule, an uninitialised checkout would deploy an empty directory
git submodule update --init talks
if [ -z "$(ls -A talks)" ]; then
  echo "error: ./talks is empty after submodule checkout, refusing to deploy" >&2
  exit 1
fi

ssh "$target" mkdir -p "'$root'"/{blog,notes,templates,talks,static}

sync() {
  echo ">> $1 -> $target:$root/$2"
  rsync -az --delete --exclude=.git "$1/" "$target:$root/$2/"
}

sync blog blog
sync notes notes
sync templates templates
sync talks talks
sync cmd/server/static static

systemctl="${WEBSITE_SYSTEMCTL:-sudo systemctl}"
echo ">> $target: reloading $service"
ssh "$target" "$systemctl reload '$service'"
